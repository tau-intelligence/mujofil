material {
    name : layered_proof,
    shadingModel : unlit,
    instanced : true
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // gl_Layer routing is injected by the forked main.vs (gl_Layer = instance)
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Distinct color per batch world (instance) so each array layer differs.
        float i = float(getInstanceIndex());
        material.baseColor = vec4(fract(i * 0.3700),
                                  fract(i * 0.6100),
                                  fract(i * 0.1300), 1.0);
    }
}
